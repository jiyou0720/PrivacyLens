{
  "manifest_version": 3,
  "name": "PrivacyLens",
  "version": "0.1.10",
  "description": "회원가입 화면의 개인정보 유형과 동의 항목을 확인합니다.",
  "action": { "default_popup": "index.html", "default_title": "PrivacyLens" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://privacylens.site/*"],
  "optional_host_permissions": ["https://*/*"]
}